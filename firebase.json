{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firebase/**", "README.md", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
      { "source": "firebase-config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  }
}
